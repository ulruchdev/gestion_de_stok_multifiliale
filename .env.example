# === Rate Limiting ===
# Toutes optionnelles — valeurs ci-dessous = défauts appliqués si non définies (voir application.yml).
# Ne jamais commiter de valeur de test/debug ici ni dans application.yml.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_ENABLED=true
RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_MAX_ATTEMPTS=5
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
RATE_LIMIT_INSCRIPTION_ENTREPRISE_MAX_ATTEMPTS=3
RATE_LIMIT_INSCRIPTION_ENTREPRISE_WINDOW_SECONDS=3600
RATE_LIMIT_INSCRIPTION_GROUPE_MAX_ATTEMPTS=3
RATE_LIMIT_INSCRIPTION_GROUPE_WINDOW_SECONDS=3600
RATE_LIMIT_FORGOT_PASSWORD_MAX_ATTEMPTS=3
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_RESET_PASSWORD_MAX_ATTEMPTS=3
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=900
RATE_LIMIT_CHANGE_PASSWORD_MAX_ATTEMPTS=5
RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=900
