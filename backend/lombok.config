# SonarCloud/JaCoCo : les méthodes générées par Lombok portent @lombok.Generated
# et sont exclues du calcul de couverture (elles ne sont pas de la logique métier).
# Sans ce fichier, ~60 classes d'entités faussaient la couverture du nouveau code.
config.stopBubbling = true
lombok.addLombokGeneratedAnnotation = true
